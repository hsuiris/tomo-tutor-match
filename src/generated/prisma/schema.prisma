// Tomo 資料模型
// 文件：https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // 連線池 URL（Neon pooled，serverless runtime 用）
  url       = env("DATABASE_URL")
  // 直連 URL（migration / prisma migrate deploy 用，繞過連線池）
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum JobStatus {
  OPEN
  MATCHED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeachingMode {
  ONLINE
  IN_PERSON
  BOTH
}

enum Gender {
  MALE
  FEMALE
  UNDISCLOSED
}

enum VerificationType {
  IDENTITY // 實名認證（身分證）
  BACKGROUND // 無犯罪紀錄（良民證）
  EDUCATION // 學歷與成績證明（畢業證書／成績單）
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String // 本名（不對外公開）
  displayName  String? // 公開化名
  role         Role    @default(STUDENT)
  gender       Gender  @default(UNDISCLOSED)
  avatarUrl    String? // 頭像（data URL 或外部網址）

  // 安全認證
  idVerified      Boolean @default(false) // 實名認證通過
  bgCheckVerified Boolean @default(false) // 無犯罪紀錄查驗通過
  eduVerified     Boolean @default(false) // 學歷與成績證明審核通過

  // 通知設定
  emailNotifications Boolean @default(false) // 總開關：是否把通知寄到 Email
  notifyJobUpdates   Boolean @default(true) // 案件更新（應徵、媒合結果等）
  notifyMessages     Boolean @default(true) // 收到新訊息

  // 帳號狀態
  disabled      Boolean   @default(false) // admin 停用帳號（停用後無法登入；既有 JWT session 自然到期前仍有效）
  emailVerified DateTime? // Email 驗證完成時間；null = 未驗證（會員區與互動功能被擋）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutorProfile TutorProfile?
  jobPosts     JobPost[]     @relation("StudentJobs")

  // 評價（留在個人檔案,雙向）
  reviewsAuthored Review[] @relation("ReviewsAuthored")
  reviewsReceived Review[] @relation("ReviewsReceived")

  // 聊天
  conversationsA Conversation[] @relation("ConvUserA")
  conversationsB Conversation[] @relation("ConvUserB")
  messagesSent   Message[]      @relation("MessageSender")

  verificationRequests VerificationRequest[]

  // 收藏（愛心）
  favorites Favorite[]

  // 討論區
  forumPosts   ForumPost[]  @relation("ForumPosts")
  forumReplies ForumReply[] @relation("ForumReplies")

  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  // 系統通知（審核結果等）
  notifications Notification[]

  // 應徵討論回覆
  applicationReplies ApplicationReply[] @relation("ApplicationReplies")
}

// 系統通知：平台主動發給使用者的訊息（如身分認證審核結果），顯示在訊息頁
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String? // 可選的前往連結（如審核結果連到個人檔案）
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// 忘記密碼重設權杖：只存雜湊（外洩也無法直接使用），單次有效、有期限
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256(raw token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256(raw token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// 收藏：使用者把滿意的老師卡或學生卡加入愛心清單
model Favorite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorProfileId String?
  tutorProfile   TutorProfile? @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  jobId          String?
  job            JobPost?      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  note      String? // 收藏備註（只有自己看得到）
  createdAt DateTime @default(now())

  @@unique([userId, tutorProfileId])
  @@unique([userId, jobId])
  @@index([userId])
}

// 安全認證申請（上傳證件 → 管理員審核）
model VerificationRequest {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationType
  docUrl     String? // 證件圖片（base64 data URL）；審核後即清空，不長期保留證件
  status     VerificationStatus @default(PENDING)
  note       String? // 審核備註
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status])
}

// 兩位使用者之間的一對一對話（userAId 永遠 < userBId，方便去重）
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  userA         User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime? // 收訊方開啟對話的時間；null = 未讀（未讀數與紅點用）

  @@index([conversationId])
}

model TutorProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  subjects      String[] // 科目
  levels        String[] // 可教學制（國小/國中/高中/大學/成人）
  regions       String[] // 授課地區
  hourlyRate    Int? // 時薪下限（新台幣）；配對與統計以此為準
  hourlyRateMax Int? // 時薪上限（可選；填了即為區間）
  experience    String? // 教學經歷
  education     String? // 學歷
  university    String? // 畢業大學
  eduLevel      String? // 教育程度（學士/碩士/博士/在學中…）
  mode          TeachingMode @default(BOTH)
  isPublished   Boolean      @default(false)
  ratingAvg     Float        @default(0)
  ratingCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  applications Application[]
  favoritedBy  Favorite[]

  @@index([isPublished])
}

model JobPost {
  id            String       @id @default(cuid())
  studentId     String
  student       User         @relation("StudentJobs", fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  subject       String
  level         String? // 學生年級／學制
  region        String
  mode          TeachingMode @default(BOTH)
  budget        Int? // 預算下限（每小時，新台幣）；配對以此為準
  budgetMax     Int? // 預算上限（可選；填了即為區間）
  description   String
  studentStatus String? // 學生狀況（年級、程度、學習現況）
  parentNeeds   String? // 家長訴求（希望加強的方向、期望）
  status        JobStatus    @default(OPEN)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  applications Application[]
  favoritedBy  Favorite[]

  @@index([status])
  @@index([subject])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  job       JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     TutorProfile      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  message   String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  // 應徵下的討論（案主與該應徵老師可回覆）
  replies ApplicationReply[]

  @@unique([jobId, tutorId]) // 同一案件同一老師只能應徵一次
  @@index([tutorId])
}

model ApplicationReply {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("ApplicationReplies", fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

// 評價／留言：留在「被評價者」的個人檔案底下（雙向：學生↔老師）
model Review {
  id              String   @id @default(cuid())
  revieweeId      String // 被評價的使用者
  reviewee        User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  authorId        String // 評價者
  author          User     @relation("ReviewsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  rating          Int // 1-5
  comment         String?
  // 被評價者在這段關係中的身分：當老師(true)或當學生(false)。
  // 好學生 ≠ 好老師，兩套評分各自獨立統計，不互相污染。
  revieweeAsTutor Boolean  @default(true)
  createdAt       DateTime @default(now())

  // 每人對同一對象、同一身分各能評一次（反轉關係：我的老師變我的學生，可各評一次）
  @@unique([revieweeId, authorId, revieweeAsTutor])
  @@index([revieweeId])
}

// 速率限制計數（固定視窗）。用既有的 Postgres，不額外引入 Redis。
// ponytail: 固定視窗、並發下可能略微超計，對暴力破解防護足夠；
//           若要精準或高吞吐，再換 Upstash/Redis 滑動視窗。
model RateLimit {
  key       String   @id // 例如 "login:ip:1.2.3.4" 或 "login:email:foo@bar"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

enum ForumBoard {
  TUTOR // 老師討論區
  PARENT // 家長討論區
}

model ForumPost {
  id          String       @id @default(cuid())
  board       ForumBoard
  authorId    String
  author      User         @relation("ForumPosts", fields: [authorId], references: [id], onDelete: Cascade)
  anonymous   Boolean      @default(false)
  title       String
  body        String
  createdAt   DateTime     @default(now())
  lastReplyAt DateTime     @default(now())
  replies     ForumReply[]

  @@index([board])
}

model ForumReply {
  id        String    @id @default(cuid())
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ForumReplies", fields: [authorId], references: [id], onDelete: Cascade)
  anonymous Boolean   @default(false)
  body      String
  createdAt DateTime  @default(now())

  @@index([postId])
}
